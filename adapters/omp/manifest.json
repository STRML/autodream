{
  "name": "omp",
  "session_roots_default": [
    "$HOME/.omp/agent/sessions"
  ],
  "session_glob": "*.jsonl",
  "engine_bin": "omp",
  "engine_flags_l1": [
    "--allow-home",
    "-p",
    "--approval-mode",
    "yolo",
    "--no-session",
    "--tools=Read,Write"
  ],
  "l1_model": "deepseek/deepseek-flash",
  "writes_memory": false,
  "engine_overlay": "l1-no-advisor.yml"
}
